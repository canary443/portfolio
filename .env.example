# passphrase for /admin, set the real one in .env.local (never commit it)
ADMIN_PASSWORD=

# key that signs the admin session cookie, independent of the passphrase.
# generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# optional locally; set it in prod so all serverless instances share one key.
ADMIN_SESSION_SECRET=

# vercel blob store that holds the site content (site.json).
# added by `vercel blob create-store`, pull it with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# set this in the vercel dashboard to lock /api/keepalive.
# vercel cron then sends it as `Authorization: Bearer <value>`.
# empty: the keepalive route stays open to anyone.
CRON_SECRET=

# site verification codes, printed as meta tags in the head.
# google search console -> add property -> html tag -> the content value.
# yandex webmaster -> add site -> meta tag -> the content value.
# empty: no tag is printed and nothing breaks.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
